        # Compute the conditional variances
        for t in range(1, T):
            h_t = np.exp(f[t - 1])
            nabla_t = self.nabla_t(self.log_returns[t - 1], mu_t, h_t, delta, v1, v2)
            f[t] = omega + beta * f[t - 1] + alpha * nabla_t

        # Calculate Log Likelihood Values

        for t in range(T):
            h_t = np.exp(f[t])
            I_t = self.I_t(self.log_returns[t], mu_t, h_t, self.m(delta, v1, v2), self.s(delta, v1, v2))
            m = self.m(delta, v1, v2)
            s = self.s(delta, v1, v2)
            alpha = self.alpha_star(delta, v1, v2)
            B = self.B(delta, v1, v2)
            
            term1 = (v1 + 1) / 2 * np.log(1 + (1 / v1) * ((m + s * (self.log_returns[t] - mu_t) / np.sqrt(h_t)) / (2 * alpha))**2)
            term2 = (v2 + 1) / 2 * np.log(1 + (1 / v2) * ((m + s * (self.log_returns[t] - mu_t) / np.sqrt(h_t)) / (2 * (1 - alpha)))**2)

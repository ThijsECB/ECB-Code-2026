        """
        self.log_returns = log_returns
        self.x = x
        self.optimal_params = None
        self.log_likelihood_value = None
        self.aic = None
        self.bic = None
        self.convergence = False
        self.standard_errors = None

    def K(self, v):
        return gamma((v + 1) / 2) / (np.sqrt(np.pi * v) * gamma(v / 2))

    def B(self, delta, v1, v2):
        return delta * self.K(v1) + (1 - delta) * self.K(v2)

    def alpha_star(self, delta, v1, v2):
        B_val = self.B(delta, v1, v2)
        return (delta * self.K(v1)) / B_val

    def m(self, delta, v1, v2):
        alpha = self.alpha_star(delta, v1, v2)
        B_val = self.B(delta, v1, v2)
        return 4 * B_val * (-alpha * 2 * v1 / (v1 - 1) + (1 - alpha) * 2 * v2 / (v2 - 1))

    def s(self, delta, v1, v2):
        alpha = self.alpha_star(delta, v1, v2)
        m_val = self.m(delta, v1, v2)
        return np.sqrt(4 * (delta * alpha * 2 * v1 / (v1 - 2) + (1 - delta) * (1 - alpha) * 2 * v2 / (v2 - 2)) - m_val**2)

    def I_t(self, r_t, mu_t, h_t, m_val, s_val):
        if m_val + s_val * (r_t - mu_t) / np.sqrt(h_t) > 0:
            return 1
        else:
            return 0

    def log_likelihood(self, params):
        """
        Define the negative log-likelihood for the Linear Realized GARCH(1,1) model using AST.
        """
        T = len(self.log_returns)
        # Extract parameters from the dictionary
        omega = params["omega"]
        beta = params["beta"]
        gamma = params["gamma"]
        xi = params["xi"]
        phi = params["phi"]
        tau_1 = params["tau_1"]
        tau_2 = params["tau_2"]
        sigma_u = params["sigma_u"]
        delta = params["delta"]
        v1 = params["v1"]
        v2 = params["v2"]

        mu_t = 0
        h = np.zeros(T)
        z = np.zeros(T)
        tau = np.zeros(T)
        u = np.zeros(T)
        I_val = np.zeros(T)

        h[0] = np.var(self.log_returns[:50])

        for t in range(1, T):
            h[t] = omega + beta * h[t-1] + gamma * self.x[t-1]
        for t in range(T):
            z[t] = self.log_returns[t] / np.sqrt(h[t])
            tau[t] = tau_1 * z[t] + tau_2 * (z[t]**2 - 1)
            u[t] = self.x[t] - xi - phi * h[t] - tau[t]

            m_val = self.m(delta, v1, v2)
            s_val = self.s(delta, v1, v2)
            alpha_star_val = self.alpha_star(delta, v1, v2)
            I_val[t] = self.I_t(self.log_returns[t], mu_t, h[t], m_val, s_val)
            B_val = self.B(delta, v1, v2)

        term1 = (v1 + 1) / 2 * np.log(1 + (1 / v1) * ((m_val + s_val * (self.log_returns - mu_t) / np.sqrt(h)) / (2 * alpha_star_val))**2)
        term2 = (v2 + 1) / 2 * np.log(1 + (1 / v2) * ((m_val + s_val * (self.log_returns - mu_t) / np.sqrt(h)) / (2 * (1 - alpha_star_val)))**2)

        loglik_r = np.log(s_val) + np.log(B_val) - 0.5 * np.log(h) - (1 - I_val) * term1 - I_val * term2
        loglik_x = -0.5 * (np.log(2 * np.pi) + np.log(sigma_u**2) + (u**2) / sigma_u**2)

        return -np.mean(loglik_r + loglik_x)

    def compute_aic_bic(self, log_likelihood, num_params):
        aic = 2 * num_params - 2 * log_likelihood
        bic = np.log(len(self.log_returns)) * num_params - 2 * log_likelihood
        return aic, bic


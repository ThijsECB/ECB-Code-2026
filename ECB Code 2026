def parzen_kernel(x):
    if 0 <= np.abs(x) <= 0.5:
        return 1 - 6 * np.abs(x)**2 + 6 * np.abs(x)**3
    elif 0.5 < np.abs(x) <= 1:
        return 2 * (1 - np.abs(x))**3
    else:
        return 0

def estimate_bandwidth_per_day(omega_squared_df, rv_sparse_df, daily_counts_df, c_star=3.5134):
    """
    Estimate the bandwidth H* for each trading day.

    Parameters:
        omega_squared_df (pd.DataFrame): DataFrame containing omega^2 estimates for each day.
        rv_sparse_df (pd.DataFrame): DataFrame containing sparse realized variance (RV_sparse) for each day.
        trades_count_df (pd.DataFrame): DataFrame containing the number of trades for each day.
        c_star (float): Constant multiplier for bandwidth estimation (default: 3.5134).

    Returns:
        bandwidth_df (pd.DataFrame): DataFrame containing H* for each day.
    """
    # Initialize an empty dictionary to store H* values
    bandwidth_per_day = {}

    # Iterate through each day in omega_squared_df
    for date, row in omega_squared_df.iterrows():
        omega_squared = row['Omega_squared']
        sparse_rv = rv_sparse_df.loc[date, 'RV_Sparse'] 
        n = daily_counts_df.loc[date, 'NumReturns']


        xi_squared = omega_squared / sparse_rv

        # Calculate bandwidth H*
        H_star = c_star * (xi_squared**(4/5)) * (n**(3/5))
        H_star = int(np.ceil(H_star))  # Round up to the nearest integer

        # Store the result
        bandwidth_per_day[date] = H_star

    # Convert results to DataFrame
    bandwidth_df = pd.DataFrame(list(bandwidth_per_day.items()), columns=['Date', 'H_star'])
    bandwidth_df['Date'] = pd.to_datetime(bandwidth_df['Date'])
    bandwidth_df.set_index('Date', inplace=True)

    return bandwidth_df


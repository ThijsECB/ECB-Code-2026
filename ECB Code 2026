class ASTGASModel:
    # Class variables for model name and distribution type
    model_name = "GAS-ast"
    distribution = "AST"

    def __init__(self, log_returns):
        # Initialize instance variables
        self.log_returns = log_returns
        self.optimal_params = None
        self.log_likelihood_value = None
        self.aic = None
        self.bic = None
        self.convergence = None
        self.standard_errors = None

    def K(self, v):
        # Compute the K function for given degrees of freedom v
        return gamma((v + 1) / 2) / (np.sqrt(np.pi * v) * gamma(v / 2))

    def B(self, delta, v1, v2):
        # Compute the B function for given parameters delta, v1, and v2
        return delta * self.K(v1) + (1 - delta) * self.K(v2)

    def alpha_star(self, delta, v1, v2):
        # Compute alpha_star
        B = self.B(delta, v1, v2)
        return (delta * self.K(v1)) / B

    def m(self, delta, v1, v2):
        # Compute m
        alpha = self.alpha_star(delta, v1, v2)
        B = self.B(delta, v1, v2)
        return 4 * B * (-alpha**2 * v1 / (v1 - 1) + (1 - alpha)**2 * v2 / (v2 - 1))

    def s(self, delta, v1, v2):
        # Compute s
        alpha = self.alpha_star(delta, v1, v2)
        B = self.B(delta, v1, v2)
        m = self.m(delta, v1, v2)
        return np.sqrt(4 * (delta * alpha**2 * v1 / (v1 - 2) + (1 - delta) * (1 - alpha)**2 * v2 / (v2 - 2)) - m**2)

    def I_t(self, r_t, mu_t, h_t, m, s):
        # Indicator function I_t
        return 1 if m + s * (r_t - mu_t) / np.sqrt(h_t) > 0 else 0

    def nabla_t(self, r_t, mu_t, h_t, delta, v1, v2):
        # Compute the score function nabla_t
        I_t = self.I_t(r_t, mu_t, h_t, self.m(delta, v1, v2), self.s(delta, v1, v2))
        m = self.m(delta, v1, v2)
        s = self.s(delta, v1, v2)
        alpha = self.alpha_star(delta, v1, v2)
        term1 = (s * (r_t - mu_t) / np.sqrt(h_t) + m) / (4 * (1 - alpha)**2 * v2 * ((s * (r_t - mu_t) / np.sqrt(h_t) + m)**2 / (4 * (1 - alpha)**2 * v2) + 1) * np.sqrt(h_t))
        term2 = (s * (r_t - mu_t) / np.sqrt(h_t) + m) / (4 * alpha**2 * v1 * ((s * (r_t - mu_t) / np.sqrt(h_t) + m)**2 / (4 * alpha**2 * v1) + 1) * np.sqrt(h_t))
        return -0.5 + I_t * (v2 + 1) / 2 * term1 + (1 - I_t) * (v1 + 1) / 2 * term2

    def log_likelihood(self, params):
        # Calculate the log-likelihood of the GAS-ast model
        omega, alpha, beta, delta, v1, v2 = params
        T = len(self.log_returns)
        mu_t = 0  # Mean of the data

        # Initialize f_t
        f = np.zeros(T)

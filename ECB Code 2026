class rolling_window:
    def __init__(self, window=5, horizon=1, period=1):
        self.window = window
        self.horizon = horizon
        self.period = period

    def split(self, data):
        data_length = data.shape[0]
        output_train = []
        output_test = []

        start = 0
        while start + self.window + self.horizon <= data_length:
            train_indices = list(np.arange(start, start + self.window))
            test_indices = list(np.arange(start + self.window, start + self.window + self.horizon))
            output_train.append(train_indices)
            output_test.append(test_indices)
            start += self.period

        index_output = [(train, test) for train, test in zip(output_train, output_test)]
        return index_output

def ast_pdf(x, mu_t, h_t, alpha, nu1, nu2):
    """
    Compute the PDF of the Asymmetric Student-t (AST) distribution.

    Parameters:
        x (float or array-like): Values of the random variable for which the PDF is evaluated.
        mu_t (float): Location parameter (mean of the distribution).
        h_t (float): Scale parameter (variance component).
        alpha (float): Skewness parameter (0 < alpha < 1).
        nu1 (float): Left tail parameter (nu1 > 2).
        nu2 (float): Right tail parameter (nu2 > 2).

    Returns:
        array-like: The PDF values evaluated at `x`.
    """
    # Compute constants
    K_nu1 = gamma((nu1 + 1) / 2) / (np.sqrt(np.pi * nu1) * gamma(nu1 / 2))
    K_nu2 = gamma((nu2 + 1) / 2) / (np.sqrt(np.pi * nu2) * gamma(nu2 / 2))
    B = alpha * K_nu1 + (1 - alpha) * K_nu2
    alpha_star = alpha * K_nu1 / B

    m = 4 * B * (-alpha_star**2 * nu1 / (nu1 - 1) + (1 - alpha_star)**2 * nu2 / (nu2 - 1))
    s = np.sqrt(
        4 * (alpha * alpha_star**2 * nu1 / (nu1 - 2) + (1 - alpha) * (1 - alpha_star)**2 * nu2 / (nu2 - 2)) - m**2
    )

    # Adjust the inputs
    z = (x - mu_t) / np.sqrt(h_t)
    scaled_z = m + s * z

    # Indicator for left or right tail
    I_t = (scaled_z > 0).astype(float)

    # Compute the PDF
    left_tail = (1 + (1/nu1)*((m + s * (x/np.sqrt(h_t)))/(2*alpha_star) )**2 )**(-(nu1+1)/2)   
    right_tail = (1 + (1/nu2)*((m + s * (x/np.sqrt(h_t)))/(2*alpha_star) )**2 )**(-(nu2+1)/2)  
    pdf = ((s * B) / np.sqrt(h_t)) * (left_tail * (1 - I_t) + right_tail * I_t)

    return pdf

def egb2_pdf(x, mu_t, h_t, p, q):
    """
    Compute the Probability Density Function (PDF) of the Exponential Generalized Beta (EGB2) distribution.
    
    Parameters:
        x (float or array-like): Values of the random variable for which the PDF is evaluated.
        mu_t (float): Location parameter (mean of the distribution). 
        h_t (float): Scale parameter (variance component).
        p (float): First shape parameter controlling skewness and kurtosis (p > 0).
        q (float): Second shape parameter controlling skewness and kurtosis (q > 0).
    
    Returns:
        float or array-like: The PDF values evaluated at `rt`.
    """
    delta = digamma(p) - digamma(q)
    omega = polygamma(0, p) + polygamma(0, q)
    term = np.sqrt(omega) *  (x - mu_t) / np.sqrt(h_t) + delta
    numerator = np.sqrt(omega) * np.exp(p * term)
    denominator = np.sqrt(h_t) * gamma(p) * gamma(q) / gamma(p + q) * ((1 + np.exp(term)) ** (p + q))
    return numerator / denominator

def calculate_quantile(distribution, alpha, params, sigma_forecast):
    """
    Calculate the quantile for a specified distribution using numerical integration.
    
    Parameters:
        distribution (str): The name of the distribution ("Skewed Student-t", "EGB2", or "AST").
        alpha (float): Tail probability (e.g., 0.05 for the 5th percentile).
        params (dict): Parameters of the specified distribution.
            For "EGB2":
                - 'p' (float): First shape parameter (p > 0).
                - 'q' (float): Second shape parameter (q > 0).
            For "AST":
                - 'alpha' (float): Skewness parameter (0 < alpha < 1).
                - 'nu1' (float): Left tail parameter (nu1 > 2).
                - 'nu2' (float): Right tail parameter (nu2 > 2).
        sigma_forecast (float): The forecasted volatility required for the quantile calculation.
    
    Returns:
        float: The quantile corresponding to the specified tail probability `alpha`.
    """
    # Grid settings
    dLBofGrid = -20
    dUBofGrid = 20
    dDistanceBetweenGridPoints = 0.001
    vGridCenters = np.arange(
        dLBofGrid + 0.5 * dDistanceBetweenGridPoints,
        dUBofGrid,
        dDistanceBetweenGridPoints,
    )
    
    #Mean of zero
    mu_t = 0 
    if distribution == "EGB2":
        p = params['p']
        q = params['q']
        vPdf = egb2_pdf(vGridCenters, mu_t, sigma_forecast, p, q)
    
    elif distribution == "AST":
        alpha_param = params['delta']
        nu1 = params['v1']
        nu2 = params['v2']
        vPdf = ast_pdf(vGridCenters, mu_t, sigma_forecast, alpha_param, nu1, nu2)
    
    # Compute the CDF via numerical integration
    vCDF = np.cumsum(vPdf) * dDistanceBetweenGridPoints

    if alpha > vCDF[-1]:  
        quantile_index = len(vGridCenters) - 1  # Use the last index
    else:
        quantile_index = np.searchsorted(vCDF, alpha)   
    # Find the quantile index
    #quantile_index = np.searchsorted(vCDF, alpha)
    return vGridCenters[quantile_index]

def calculate_var(model, sigma_forecast,confidence_level):
    """
    Calculate the Value-at-Risk (VaR) for a given sigma_forecast and confidence level.
    
    Parameters:
        model: An instance of a class with the `distribution` attribute specifying the distribution.
        sigma_forecast: The forecasted volatility (standard deviation).
        confidence_level: Confidence level for VaR calculation (default is 0.95).
        
    Returns:
        VaR: The calculated Value-at-Risk.
    """
    alpha = 1 - confidence_level  
    mu_t = 0
    if model.distribution == "Normal":
        z_alpha = scipy.stats.norm.ppf(alpha)
        VaR = mu_t  + z_alpha *  np.sqrt(sigma_forecast)

    elif model.distribution == "Student t":
        nu = model.optimal_params["nu1"] 
        t_alpha = scipy.stats.t.ppf(alpha, df=nu) * np.sqrt((nu - 2) / nu)  
        VaR = mu_t + t_alpha * np.sqrt(sigma_forecast)

    elif model.distribution == "AST":
        AST_alpha = calculate_quantile("AST", alpha, model.optimal_params,sigma_forecast)
        VaR = mu_t + (AST_alpha * np.sqrt(sigma_forecast))

    elif model.distribution == "EGB2":
        EGB2_alpha = calculate_quantile("EGB2", alpha, model.optimal_params,sigma_forecast)
        VaR = mu_t + (EGB2_alpha * np.sqrt(sigma_forecast))
  
    return VaR

def backtest_var(v_indicator_violations, prob_var_violation_under_h0):
    v_indicator_violations = np.asarray(v_indicator_violations)
    n_total = len(v_indicator_violations)
    n = n_total - 1

    i_n00 = np.sum((v_indicator_violations[:-1] == 0) & (v_indicator_violations[1:] == 0))
    i_n01 = np.sum((v_indicator_violations[:-1] == 0) & (v_indicator_violations[1:] == 1))
    i_n10 = np.sum((v_indicator_violations[:-1] == 1) & (v_indicator_violations[1:] == 0))
    i_n11 = np.sum((v_indicator_violations[:-1] == 1) & (v_indicator_violations[1:] == 1))

    i_n0 = i_n00 + i_n10
    i_n1 = i_n01 + i_n11

    d_logl_h0 = i_n0 * np.log(1 - prob_var_violation_under_h0) + i_n1 * np.log(prob_var_violation_under_h0)
    d_logl_h1_uc = 0
    if i_n0 > 0:
        d_logl_h1_uc += i_n0 * np.log(i_n0 / n)
    if i_n1 > 0:
        d_logl_h1_uc += i_n1 * np.log(i_n1 / n)

    d_logl_h1_cc = 0
    if i_n00 > 0:
        d_logl_h1_cc += i_n00 * np.log(i_n00 / (i_n00 + i_n01))
    if i_n01 > 0:
        d_logl_h1_cc += i_n01 * np.log(i_n01 / (i_n00 + i_n01))
    if i_n10 > 0:
        d_logl_h1_cc += i_n10 * np.log(i_n10 / (i_n10 + i_n11))
    if i_n11 > 0:
        d_logl_h1_cc += i_n11 * np.log(i_n11 / (i_n10 + i_n11))

    dLR_UC_VaR = 2 * (d_logl_h1_uc - d_logl_h0)
    dLR_CC_VaR = 2 * (d_logl_h1_cc - d_logl_h0)
    dLR_IND_VaR = dLR_CC_VaR - dLR_UC_VaR

    dPvalue_UC_VaR = 1 - chi2.cdf(dLR_UC_VaR, 1)
    dPvalue_CC_VaR = 1 - chi2.cdf(dLR_CC_VaR, 2)
    dPvalue_IND_VaR = 1 - chi2.cdf(dLR_IND_VaR, 1)

    return dLR_UC_VaR, dPvalue_UC_VaR, dLR_CC_VaR, dPvalue_CC_VaR, dLR_IND_VaR, dPvalue_IND_VaR

def calculate_factor(log_returns_in_sample, kernel_in_sample):
    """
    Calculate the factor for scaling forecasts.

    Parameters:
    - log_returns_in_sample: Array of log returns in the training window.
    - kernel_in_sample: Array of realized kernel values in the training window.

    Returns:
    - factor: Scaling factor for forecast adjustment.
    """
    sample_variance = np.var(log_returns_in_sample, ddof=1)
    sample_mean_kernel = np.mean(kernel_in_sample)
    return sample_variance / sample_mean_kernel



def calculate_dm_test_multiple(realized_kernel, forecasts):
    """
    Perform Diebold-Mariano test for multiple models.

    Parameters:
    - realized_kernel: Array of realized kernel values.
    - forecasts: Dictionary with model names as keys and forecast arrays as values.

    Returns:
    - A DataFrame containing DM statistics and p-values for each pair of models.
    """
    model_names = list(forecasts.keys())
    dm_results = []

    # Compare each pair of models
    for model1, model2 in combinations(model_names, 2):
        errors1 = np.array(forecasts[model1]) - np.array(realized_kernel)
        errors2 = np.array(forecasts[model2]) - np.array(realized_kernel)
        
        # Compute DM test statistic
        d = errors1**2 - errors2**2
        N = len(d)
        d_mean = np.mean(d)
        d_std = np.std(d, ddof=1)
        dm_stat = np.sqrt(N) * d_mean / d_std
        p_value = 2 * (1 - norm.cdf(abs(dm_stat)))
        
        dm_results.append({
            "Model 1": model1,
            "Model 2": model2,
            "DM Statistic": dm_stat,
            "P-Value": p_value
        })

    return pd.DataFrame(dm_results)



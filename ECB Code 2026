            u[t] = np.log(self.x[t]) - xi - phi * log_h[t] - tau[t]

        # Compute log-likelihood components for returns and realized measures
        loglik_r = (gammaln((nu + 1) / 2) - gammaln(nu / 2) - 0.5 * np.log((nu - 2) * np.pi * np.exp(log_h)) -
                    (nu + 1) / 2 * np.log(1 + (self.log_returns**2) / ((nu - 2) * np.exp(log_h))))
        loglik_x = -0.5 * (np.log(2 * np.pi) + np.log(sigma_u**2) + (u**2) / sigma_u**2)

        # Return the negative average log-likelihood
        return -np.mean(loglik_r + loglik_x)

    def compute_aic_bic(self, log_likelihood, num_params):
        """
        Compute the Akaike Information Criterion (AIC) and Bayesian Information Criterion (BIC).

        Parameters:
        - log_likelihood: Log-likelihood value.
        - num_params: Number of model parameters.

        Returns:
        - AIC and BIC values.
        """
        aic = 2 * num_params - 2 * log_likelihood
        bic = np.log(len(self.log_returns)) * num_params - 2 * log_likelihood
        return aic, bic

    def optimize(self, initial_params=None, compute_metrics = False):
        """
        Estimate the parameters of the GARCH(1,1) model using maximum likelihood.

        Parameters:
        - initial_params: Optional initial guesses for the parameters.

        Returns:
        - Optimal parameters, AIC, BIC, log-likelihood value, and standard errors.
        """
        if initial_params is None:
            if self.optimal_params is not None:
                initial_params = self.optimal_params
            else:
                initial_params = {
                    "omega": np.exp(0.06),
                    "beta": 0.55,

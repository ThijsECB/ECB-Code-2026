                    grad = approx_fprime(result.x, lambda params: self.log_likelihood(dict(zip(keys, params))), epsilon)
                    self.standard_errors = np.sqrt(np.diag(np.outer(grad, grad)))
                except Exception as e:
                    print(f"Fallback standard error computation failed: {e}")
                    self.standard_errors = np.full(len(result.x), np.nan)
           
            return self.optimal_params, self.aic, self.bic, self.log_likelihood_value, self.standard_errors
        else:
            return self.optimal_params
        



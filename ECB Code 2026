        initial_params_list = list(initial_params.values())
        
        
        constraint = ({'type': 'ineq', 'fun': lambda x: 1 - x[1] -x[2]*x[4]})

        result = minimize(
            lambda params: self.log_likelihood(dict(zip(keys, params))),  # Map params to dictionary
            initial_params_list,
            method='SLSQP',
            bounds=[
                (-np.inf, np.inf),  
                (0, np.inf),      
                (0, np.inf),       
                (-np.inf, np.inf),  
                (0, np.inf),       
                (-np.inf, np.inf), 
                (-np.inf, np.inf), 
                (0.00001, np.inf),
                (2.00001,np.inf)],
                constraints=constraint
            )
        
        self.convergence = result.success
        if self.convergence:
            self.optimal_params = {

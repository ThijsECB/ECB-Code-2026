class GARCHMLModel:
    model_name = "GARCH-ML"
    distribution = 'Student t'
    def __init__(self, returns):
        self.returns = returns
        self.optimal_params = None
        self.log_likelihood_value = None
        self.aic = None
        self.bic = None
        self.convergence = None
        self.standard_errors = None

    def log_likelihood(self, params):
        """
        Compute the log-likelihood for the GARCH-M-L model.
        """
        # Ensure params are correctly unpacked as numbers
        mu, omega, alpha, beta, delta, gamma, lamb, nu = params

        T = len(self.returns)
        sigma_bar = np.var(self.returns[:50])

        sigma2 = np.zeros(T)
        sigma2[0] = sigma_bar

        log_likelihood = 0.0

        for t in range(1, T):
            term1 = alpha + (delta * np.tanh(-gamma * self.returns[t - 1]))
            term2 = ((self.returns[t - 1] - mu - lamb * sigma2[t - 1]) / np.sqrt(sigma2[t - 1]))**2
            sigma2[t] = omega + (term1 * term2) + (beta * sigma2[t - 1])

            if sigma2[t] <= 0:
                return 1e6

        for t in range(T):
            resid = ((self.returns[t] - mu - lamb * sigma2[t]) / np.sqrt(sigma2[t]))**2
            term1 = lgamma((nu + 1) / 2) - lgamma(nu / 2) - 0.5 * np.log(nu * np.pi)
            term2 = -0.5 * np.log(sigma2[t])
            term3 = -((nu + 1) / 2) * np.log(1 + (resid / nu))
            log_likelihood += term1 + term2 + term3

        penalized_log_likelihood = log_likelihood - (0.001 * gamma**2)
        return -np.mean(penalized_log_likelihood)

    @staticmethod
    def compute_aic_bic(log_likelihood, num_params, returns):
        """
        Compute AIC and BIC based on log-likelihood, number of parameters, and number of observations.
        """
        aic = 2 * num_params - 2 * log_likelihood
        bic = np.log(len(returns)) * num_params - 2 * log_likelihood
        return aic, bic
    

    def  optimize(self, initial_params=None, compute_metrics=False):
        """
        Perform GARCH-M-L optimization and calculate AIC and BIC.
        """
        if initial_params is None:
            if self.optimal_params is not None:
                initial_params = self.optimal_params
            else:    
                initial_params = {
                    "mu": 0,
                    "omega": np.var(self.returns[:50]) / 50,
                    "alpha": 0.05,
                    "beta": 0.9,
                    "delta": 0.01,
                    "gamma": 0.01,
                    "lamb": 0,
                    "nu1": 10
                }
        
        keys = list(initial_params.keys())
        # Convert initial parameters to a list for optimization
        initial_params_list = list(initial_params.values())

        # Define constraints
        constraints = [
            {'type': 'ineq', 'fun': lambda params: params[2] - abs(params[4])},
            {'type': 'ineq', 'fun': lambda params: params[3]},
            {'type': 'ineq', 'fun': lambda params: params[5]}
        ]

        result = minimize(self.log_likelihood, initial_params_list, method='SLSQP', constraints=constraints)
        self.convergence = result.success
        if self.convergence:
            # Optimization succeeded: update parameters
            self.optimal_params = dict(zip(keys, result.x))
            print(f"Model: {self.model_name} | Convergence: Success")
        else:
            # Optimization failed: Keep the previous MLE values

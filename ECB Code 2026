        self.standard_errors = None

    def K(self, v):
        return gamma((v + 1) / 2) / (np.sqrt(np.pi * v) * gamma(v / 2))

    def B(self, delta, v1, v2):
        return delta * self.K(v1) + (1 - delta) * self.K(v2)

    def alpha_star(self, delta, v1, v2):
        B_val = self.B(delta, v1, v2)
        return (delta * self.K(v1)) / B_val

    def m(self, delta, v1, v2):
        alpha = self.alpha_star(delta, v1, v2)
        B_val = self.B(delta, v1, v2)
        return 4 * B_val * (-alpha * 2 * v1 / (v1 - 1) + (1 - alpha) * 2 * v2 / (v2 - 1))

    def s(self, delta, v1, v2):
        alpha = self.alpha_star(delta, v1, v2)
        m_val = self.m(delta, v1, v2)
        return np.sqrt(4 * (delta * alpha * 2 * v1 / (v1 - 2) + (1 - delta) * (1 - alpha) * 2 * v2 / (v2 - 2)) - m_val**2)

    def I_t(self, r_t, mu_t, h_t, m_val, s_val):
        return 1 if m_val + s_val * (r_t - mu_t) / np.sqrt(h_t) > 0 else 0


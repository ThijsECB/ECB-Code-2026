class LinearRealizedGARCHModelStudentt:
    model_name = "Linear Realized GARCH Model Student t"
    distribution = "Student t"
    
    def __init__(self, log_returns, x):
        """
        Initialize the Linear Realized GARCH(1,1) model.

        Parameters:
        - log_returns: Array of log returns (dependent variable).
        - x: Array of realized measures (independent variable).
        """
        self.log_returns = log_returns
        self.x = x
        self.optimal_params = None
        self.log_likelihood_value = None
        self.aic = None
        self.bic = None
        self.convergence = None
        self.standard_errors = None

    def log_likelihood(self, params):
        """
        Compute the negative log-likelihood for the Linear Realized GARCH(1,1) model with Student's t innovations.

        Parameters:
        - params: Dictionary of model parameters to estimate.

        Returns:
        - Negative log-likelihood value.
        """
        T = len(self.log_returns)
        
        # Extract parameters
        omega = np.exp(params["omega"])
        beta = np.exp(params["gamma"]) / (np.exp(params["gamma"]) + np.exp(params["beta"]) + 1)
        gamma = np.exp(-params["phi"]) * (np.exp(params["beta"]) / (np.exp(params["gamma"]) + np.exp(params["beta"]) + 1))
        xi = np.exp(params["xi"])
        phi = np.exp(params["phi"])
        tau_1 = params["tau_1"]
        tau_2 = params["tau_2"]
        sigma_u = np.exp(params["sigma_u"])
        nu = np.exp(params["nu1"])
        
        # Initialize arrays
        h = np.zeros(T)
        z = np.zeros(T)
        tau = np.zeros(T)
        u = np.zeros(T)
        
        # Initialize conditional variance
        h[0] = np.var(self.log_returns[:50])

        # Compute conditional variance over time
        for t in range(1, T):
            h[t] = omega + beta * h[t-1] + gamma * self.x[t-1]

        # Compute auxiliary variables and log-likelihood components
        for t in range(T):
            z[t] = self.log_returns[t] / np.sqrt(h[t])
            tau[t] = tau_1 * z[t] + tau_2 * (z[t]**2 - 1)
            u[t] = self.x[t] - xi - phi * h[t] - tau[t]

        loglik_r = (
            gammaln((nu + 1) / 2) - gammaln(nu / 2)
            - 0.5 * np.log((nu - 2) * np.pi * h)
            - (nu + 1) / 2 * np.log(1 + (self.log_returns**2) / ((nu - 2) * h))
        )
        loglik_x = -0.5 * (np.log(2 * np.pi) + np.log(sigma_u**2) + (u**2) / sigma_u**2)

        return -np.mean(loglik_r + loglik_x)
    
    def compute_aic_bic(self, log_likelihood, num_params):
        """
        Compute the AIC and BIC for the model.

        Parameters:
        - log_likelihood: Log-likelihood value.
        - num_params: Number of estimated parameters.

        Returns:
        - Tuple of (AIC, BIC).
        """
        aic = 2 * num_params - 2 * log_likelihood

def ast_pdf(x, mu_t, h_t, alpha, nu1, nu2):
    """
    Compute the PDF of the Asymmetric Student-t (AST) distribution.

    Parameters:
        x (float or array-like): Values of the random variable for which the PDF is evaluated.
        mu_t (float): Location parameter (mean of the distribution).
        h_t (float): Scale parameter (variance component).
        alpha (float): Skewness parameter (0 < alpha < 1).
        nu1 (float): Left tail parameter (nu1 > 2).
        nu2 (float): Right tail parameter (nu2 > 2).

    Returns:
        array-like: The PDF values evaluated at `x`.
    """
    # Compute constants
    K_nu1 = gamma((nu1 + 1) / 2) / (np.sqrt(np.pi * nu1) * gamma(nu1 / 2))
    K_nu2 = gamma((nu2 + 1) / 2) / (np.sqrt(np.pi * nu2) * gamma(nu2 / 2))
    B = alpha * K_nu1 + (1 - alpha) * K_nu2
    alpha_star = alpha * K_nu1 / B

    m = 4 * B * (-alpha_star**2 * nu1 / (nu1 - 1) + (1 - alpha_star)**2 * nu2 / (nu2 - 1))
    s = np.sqrt(
        4 * (alpha * alpha_star**2 * nu1 / (nu1 - 2) + (1 - alpha) * (1 - alpha_star)**2 * nu2 / (nu2 - 2)) - m**2
    )

    # Adjust the inputs
    z = (x - mu_t) / np.sqrt(h_t)
    scaled_z = m + s * z

    # Indicator for left or right tail
    I_t = (scaled_z > 0).astype(float)

    # Compute the PDF
    left_tail = (1 + (1/nu1)*((m + s * (x/np.sqrt(h_t)))/(2*alpha_star) )**2 )**(-(nu1+1)/2)   
    right_tail = (1 + (1/nu2)*((m + s * (x/np.sqrt(h_t)))/(2*alpha_star) )**2 )**(-(nu2+1)/2)  
    pdf = ((s * B) / np.sqrt(h_t)) * (left_tail * (1 - I_t) + right_tail * I_t)

    return pdf

def egb2_pdf(x, mu_t, h_t, p, q):
    """
    Compute the Probability Density Function (PDF) of the Exponential Generalized Beta (EGB2) distribution.
    
    Parameters:
        x (float or array-like): Values of the random variable for which the PDF is evaluated.
        mu_t (float): Location parameter (mean of the distribution). 
        h_t (float): Scale parameter (variance component).
        p (float): First shape parameter controlling skewness and kurtosis (p > 0).
        q (float): Second shape parameter controlling skewness and kurtosis (q > 0).
    
    Returns:
        float or array-like: The PDF values evaluated at `rt`.
    """
    delta = digamma(p) - digamma(q)
    omega = polygamma(0, p) + polygamma(0, q)
    term = np.sqrt(omega) *  (x - mu_t) / np.sqrt(h_t) + delta
    numerator = np.sqrt(omega) * np.exp(p * term)
    denominator = np.sqrt(h_t) * gamma(p) * gamma(q) / gamma(p + q) * ((1 + np.exp(term)) ** (p + q))
    return numerator / denominator



def compute_shifted_rvs_multi_day(log_prices, window_size=1200, shifts=1200):
    """
    Compute realized variances for shifted time series of 20-minute returns for multiple days.
    
    Parameters:
        log_prices (pd.Series): Log-price series at 1-second frequency with a datetime index.
        window_size (int): Number of seconds in a 20-minute window (default: 1200).
        shifts (int): Number of 1-second shifts to generate (default: 1200).
    
    Returns:
        rv_sparse_df (pd.DataFrame): Realized variances (RV_sparse) for each trading day.
    """
    # Ensure the index is datetime
    log_prices.index = pd.to_datetime(log_prices.index)

    # Group data by trading day
    grouped = log_prices.groupby(log_prices.index.date)

    # Store results for each day
    daily_rv_sparse = {}

    for day, daily_prices in grouped:
        n = len(daily_prices)  # Total number of data points for the day
        shifted_returns = []  # To store 20-minute returns for the first shift

        # Only compute the first RV value (shift = 0)
        for start in range(0, n - window_size, window_size):
            end = start + window_size
            log_return = daily_prices.iloc[end] - daily_prices.iloc[start]
            shifted_returns.append(log_return)

        # Compute the realized variance for the first shift
        rv_sparse = np.sum(np.square(shifted_returns))
        daily_rv_sparse[day] = rv_sparse

    # Store the results
    rv_sparse_df = pd.DataFrame(list(daily_rv_sparse.items()), columns=['Date', 'RV_Sparse'])
    rv_sparse_df['Date'] = pd.to_datetime(rv_sparse_df['Date'])
    rv_sparse_df.set_index("Date", inplace=True)

    return rv_sparse_df


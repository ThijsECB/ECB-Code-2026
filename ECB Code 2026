class LinearRealizedGARCHModelNormal:
    model_name = "LinearRealizedGARCHModelNormal"
    distribution = "Normal"
    def __init__(self, log_returns, x):
        """
        Initialize the model with log returns and realized measures.
        
        Parameters:
        - log_returns: Array of log returns.
        - x: Array of realized measures (e.g., volatility proxy).
        """
        self.log_returns = log_returns
        self.x = x
        self.optimal_params = None
        self.log_likelihood_value = None
        self.convergence = False
        self.aic = None
        self.bic = None
        self.standard_errors = None

    def log_likelihood(self, params):
        """
        Compute the negative log-likelihood for the GARCH(1,1) model with normal distribution.

        Parameters:
        - params: Dictionary of model parameters.

        Returns:
        - Negative log-likelihood value.
        """
        T = len(self.log_returns)  # Number of observations

        omega = params["omega"]
        beta = params["beta"]
        gamma = params["gamma"]
        xi = params["xi"]
        phi = params["phi"]
        tau_1 = params["tau_1"]
        tau_2 = params["tau_2"]
        sigma_u = params["sigma_u"]

        # Initialize arrays for variance (h), standardized residuals (z), and auxiliary variables
        h = np.zeros(T)
        z = np.zeros(T)
        tau = np.zeros(T)
        u = np.zeros(T)

        # Initialize h with the variance of log returns
        h[0] = np.var(self.log_returns[:50])

        # Recursively compute the conditional variance h_t
        for t in range(1, T):
            h[t] = omega + beta * h[t-1] + gamma * self.x[t-1]

        # Compute standardized residuals and auxiliary variables
        for t in range(T):
            z[t] = self.log_returns[t] / np.sqrt(h[t])
            tau[t] = tau_1 * z[t] + tau_2 * (z[t]**2 - 1)
            u[t] = self.x[t] - xi - phi * h[t] - tau[t]

        # Compute log-likelihood components for returns and realized measures
        loglik_r = -0.5 * (np.log(2 * np.pi) + np.log(h) + (self.log_returns**2) / h)
        loglik_x = -0.5 * (np.log(2 * np.pi) + np.log(sigma_u**2) + (u**2) / sigma_u**2)

        # Return the negative average log-likelihood
        return -np.mean(loglik_r + loglik_x)
    
    
    def calculate_aic_bic(self,log_likelihood, num_params):
        """
        Compute the Akaike Information Criterion (AIC) and Bayesian Information Criterion (BIC).

        Parameters:
        - log_likelihood: Log-likelihood value.
        - num_params: Number of model parameters.

        Returns:
        - AIC and BIC values.
        """
        aic = 2 * num_params - 2 * log_likelihood
        bic = np.log(len(self.log_returns)) * num_params - 2 * log_likelihood
        return aic, bic

    def optimize(self, initial_params=None,compute_metrics = False):
        """
        Estimate the parameters of the GARCH(1,1) model using maximum likelihood.

        Parameters:
        - initial_params: Optional initial guesses for the parameters.


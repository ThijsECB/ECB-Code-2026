                epsilon = np.sqrt(np.finfo(float).eps)
                grad = approx_fprime(list(self.optimal_params.values()), lambda params: self.log_likelihood(dict(zip(keys, params))), epsilon)
                hessian_inv = np.outer(grad, grad)
                self.standard_errors = np.sqrt(np.diag(hessian_inv))
            
            return self.optimal_params, self.aic, self.bic, self.log_likelihood_value, self.standard_errors
        else:
            return self.optimal_params

    def one_step_ahead_forecast(self):
        omega = self.optimal_params["omega"]
        beta = self.optimal_params["beta"]
        delta = self.optimal_params["delta"]
        xi = self.optimal_params["xi"]
        tau_1 = self.optimal_params["tau_1"]
        tau_2 = self.optimal_params["tau_2"]

        T = len(self.log_returns)
        log_h = np.zeros(T)
        z = np.zeros(T)
        u = np.zeros(T)
        tau = np.zeros(T)

        log_h[0] = np.log(np.var(self.log_returns[:50]))
        z[0] = self.log_returns[0] / np.sqrt(np.exp(log_h[0]))
        u[0] = np.log(self.x[0]) - xi - log_h[0]

        for t in range(1, T):
            tau[t-1] = tau_1 * z[t-1] + tau_2 * (z[t-1]**2 - 1)
            log_h[t] = omega + beta * log_h[t-1] + tau[t-1] + delta * u[t-1]
            z[t] = self.log_returns[t] / np.sqrt(np.exp(log_h[t]))
            u[t] = np.log(self.x[t]) - xi - log_h[t] 

        tau_forecast = tau_1 * z[-1] + tau_2 * (z[-1]**2 - 1)
        u_forecast = np.log(self.x[-1]) - xi - log_h[-1]
        h_forecast = omega + beta * log_h[-1] + tau_forecast + delta * u_forecast

        return np.exp(h_forecast)

from scipy.special import gamma as gammad

class EGARCHegb2Model:
    # Class variables for model name and distribution type
    model_name = "EGARCHegb2Model"
    distribution = "EGB2"

    def __init__(self, data):
        # Initialize instance variables
        self.data = data
        self.optimal_params = None
        self.log_likelihood_value = None
        self.aic = None
        self.bic = None
        self.convergence = None
        self.standard_errors = None

    def log_likelihood(self, params):
        # Calculate the log-likelihood of the EGARCH-egb2 model
        omega, alpha, beta, gamma, p, q = params
        T = len(self.data)
        mu_t = 0

        # Filter Volatility
        log_sig2 = np.zeros(T)
        log_sig2[0] = np.log(np.var(self.data[:50]))  # Initialize log volatility at log unconditional variance

        Delta = digamma(p) - digamma(q)
        Omega = polygamma(1, p) + polygamma(1, q)
        E_abs_egb2 = 0

        for t in range(1, T):
            log_sig2[t] = omega + alpha * (np.abs(self.data[t-1]) - E_abs_egb2) + gamma * self.data[t-1] + beta * log_sig2[t-1]

        sig2 = np.exp(log_sig2)

        # Calculate Log Likelihood Values
        log_likelihood = 0
        for t in range(T):
            r_t = self.data[t]
            h_t = sig2[t]
            log_likelihood += (0.5 * np.log(Omega) + p * (np.sqrt(Omega) * (r_t - mu_t) / np.sqrt(h_t) + Delta)
                               - 0.5 * np.log(h_t) - np.log(gammad(p) * gammad(q) / gammad(p + q))
                               - (p + q) * np.log(1 + np.exp(np.sqrt(Omega) * (r_t - mu_t) / np.sqrt(h_t) + Delta)))

        return -log_likelihood / T
    
    def compute_aic_bic(self, log_likelihood, num_params):
        # Compute AIC and BIC based on log-likelihood, number of parameters, and number of observations
        aic = 2 * num_params - 2 * log_likelihood
        bic = np.log(len(self.data)) * num_params - 2 * log_likelihood
        print(f"AIC: {aic}", f"BIC: {bic}")    
        return aic, bic

    def optimize(self, initial_params=None, compute_metrics=True):
        # Optimize the EGARCH-egb2 model parameters
        if initial_params is None:
            if self.optimal_params is not None:
                initial_params = self.optimal_params
            else:
                # Initial parameter values to prevent local minima
                initial_params = {
                    "omega": np.var(self.data[:50]) * (1 - 0.1 - 0.1 - 0.7),
                    "alpha": 0.1,
                    "beta": 0.7,
                    "gamma": 0.1,
                    "p": 4,
                    "q": 4
                }
        
        keys = list(initial_params.keys())
        initial_params_list = list(initial_params.values())        
            
        # Define bounds and constraints for the optimization
        bounds = ((0, 100), (0, 10), (0, 10), (-10, 10), (0.001, 100), (0.001, 100))
        constraints = ({'type': 'ineq', 'fun': lambda x: 1 - np.abs(x[2])})
       
        result = scipy.optimize.minimize(self.log_likelihood, initial_params_list, method='SLSQP', bounds=bounds, constraints=constraints)

        self.convergence = result.success
        if self.convergence:
            # Optimization succeeded: update parameters
            self.optimal_params = dict(zip(keys, result.x))
            print(f"Model: {self.model_name} | Convergence: Success")
        else:
            # Optimization failed: Keep the previous MLE values
            print(f"Warning: Optimization failed for {self.model_name}. Retaining previous parameters.")
        
        if compute_metrics and self.convergence:
            # Compute metrics if required
            self.log_likelihood_value = -result.fun
            num_params = len(initial_params_list)
            self.aic, self.bic = self.compute_aic_bic(self.log_likelihood_value, num_params)
        
            # Compute the Hessian and its inverse
            hessian = approx_hess1(list(self.optimal_params.values()), self.log_likelihood, args=())
            hessian_inv = inv(hessian) / len(self.data)

            # Compute standard errors
            self.standard_errors = np.sqrt(np.diag(hessian_inv))

            # Handle NaN values in standard errors
            if np.isnan(self.standard_errors).any():
                epsilon = np.sqrt(np.finfo(float).eps)
                grad = scipy.optimize.approx_fprime(list(self.optimal_params.values()), self.log_likelihood, epsilon)
                hessian_inv = np.outer(grad, grad)
                self.standard_errors = np.sqrt(np.diag(hessian_inv))
    
            return self.optimal_params, self.aic, self.bic, self.log_likelihood_value, self.standard_errors 
        else:
            return self.optimal_params

    def one_step_ahead_forecast(self):
        # Compute a one-step-ahead volatility forecast for the EGARCH(1,1) model
        omega, alpha, beta, gamma, p, q = list(self.optimal_params.values())

        # Most recent return and variance
        T = len(self.data)        # Length of the return series
        log_sig2 = np.zeros(T)    # Log conditional variance
        E_abs_egb2 = 1

        # Initialize the log variance (historical calculation as in model)
        log_sig2[0] = np.log(np.var(self.data[:50]))
        for t in range(1, T):
            log_sig2[t] = omega + alpha * (np.abs(self.data[t-1]) - E_abs_egb2) + gamma * self.data[t-1] + beta * log_sig2[t-1]

        # Use the last log_sig2 value for one-step-ahead forecasting
        r_T = self.data[-1]  # Last observed return
        log_sig2_T = log_sig2[-1]
        log_sig2_forecast = omega + alpha * (np.abs(r_T) - E_abs_egb2) + gamma * r_T + beta * log_sig2_T
        sigma2_forecast = np.exp(log_sig2_forecast)

        return sigma2_forecast


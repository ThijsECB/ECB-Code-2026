            hessian_inv = inv(hessian) / len(self.log_returns)

            self.standard_errors = np.sqrt(np.diag(hessian_inv))

            # Handle potential NaN values in standard errors
            if np.isnan(self.standard_errors).any():
                epsilon = np.sqrt(np.finfo(float).eps)
                grad = approx_fprime(
                    list(self.optimal_params.values()),
                    lambda params: self.log_likelihood(dict(zip(keys, params))),
                    epsilon
                )
                hessian_inv = np.outer(grad, grad)
                self.standard_errors = np.sqrt(np.diag(hessian_inv))

            
            return self.optimal_params, self.aic, self.bic, self.log_likelihood_value, self.standard_errors
        else:
            return self.optimal_params

    def one_step_ahead_forecast(self):

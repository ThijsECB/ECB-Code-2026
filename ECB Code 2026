        # Inspect model class to determine its initialization arguments
        init_params = inspect.signature(model_class.__init__).parameters
        
        # Check if the model is a Realized model (needs kernel data)
        if "X" in init_params or "realized_kernel" in init_params or 'x' in init_params:
            model = model_class(train_log_returns, train_kernel)
        else:
            model = model_class(train_log_returns)

        # Optimize the model
        print(f"Calling optimize on {model_class.__name__}...")
        opt_params = model.optimize(initial_params= None,compute_metrics = True)
        
        aic = model.aic
        bic = model.bic
        log_likelihood = model.log_likelihood_value
        std_errs = model.standard_errors

        # Store results in a dictionary
        results[model_class.model_name] = {
            "params": opt_params,  # Dictionary of optimized parameters
            "aic": aic,
            "bic": bic,
            "log_likelihood": log_likelihood,
            "std_errs": std_errs,
        }
    
    return results

def rolling_evaluation_multiple(log_returns_array, kernel_array, window_index, confidence_level, model_classes):
    """
    Perform rolling evaluation for multiple models, including DM test calculations.

    Parameters:
    - log_returns_array: Array of log returns.
    - kernel_array: Array of dependent variable (e.g., realized volatility).
    - window_index: Training window size for rolling evaluation.
    - confidence_level: Confidence level for VaR (e.g., 0.95 for 95% VaR).
    - model_classes: List of model classes to evaluate.

    Returns:
    - A dictionary summarizing key results for all models, including DM test results.
    """
    rw = rolling_window(window=window_index, horizon=1, period=1)
    splits = rw.split(log_returns_array)
    first_split = splits[0]
    
    first_window_results = optimize_first_window_multiple(log_returns_array,kernel_array, first_split, model_classes)
    
    # Show in sample results
    print("\n--- First Window Optimization Results ---")
    for model_name, result in first_window_results.items():
        print(f"\n{model_name} First Window Results:")
        print(f"Optimal Parameters: {result['params']}")
        print(f"AIC: {result['aic']}, BIC: {result['bic']}")
        print(f"Log-Likelihood: {result['log_likelihood']}")
        print(f"Standard Errors: {result['std_errs']}")

    previous_params = {model_class.model_name: None for model_class in model_classes}

    # Storage for forecasts and metrics
    forecasts = {model_class.model_name: [] for model_class in model_classes}
    realized_kernel = []
    var_results = {model_class.model_name: [] for model_class in model_classes}
    hit_var_results = {model_class.model_name: [] for model_class in model_classes}
    metrics = {model_class.model_name: {"rmse": [], "mae": []} for model_class in model_classes}
    initial_params = {model_class.model_name: None for model_class in model_classes}
    realized_kernel = []
    test_log_returns = []
    
    for train_indices, test_indices in splits:
        train_log_returns = log_returns_array[train_indices]
        test_log_return = log_returns_array[test_indices[0]]
        train_kernel = kernel_array[train_indices]
        test_kernel = kernel_array[test_indices[0]]
        factor = calculate_factor(train_log_returns, train_kernel)
        test_kernel *= factor  
        realized_kernel.append(test_kernel)
        test_log_returns.append(test_log_return)

        for model_class in model_classes:
            model_name = model_class.model_name
            init_params = inspect.signature(model_class.__init__).parameters
            
            #Check if the model is a Realized model
            if "X" in init_params or "realized_kernel" in init_params or 'x' in init_params:
                model = model_class(train_log_returns, train_kernel)
            else:
                model = model_class(train_log_returns)
            
            previous_opt_params = previous_params.get(model_name, None)
            new_params = model.optimize(initial_params=previous_opt_params, compute_metrics=False)

            if model.convergence:
                # Store the successful parameters
                previous_params[model_name] = new_params
            else:
                # **If optimization failed, keep the previous parameters**
                print(f"Warning: Optimization failed for {model_name}. Using previous parameters.")
                model.optimal_params = previous_opt_params  # Restore previous parameters


            # Perform forecast
            forecast = model.one_step_ahead_forecast()
            if np.isnan(forecast) or np.isinf(forecast):
                raise ValueError(f"Forecasting failed: NaN encountered in forecast for {model_name} and {model.optimal_params}")

            forecasts[model_name].append(forecast)
            # Calculate Value-at-Risk (VaR)
            var = calculate_var(model, forecast, confidence_level)
            var_results[model_name].append(var)

            # Check if the test log return breaches VaR
            hit_var_results[model_name].append(1 if test_log_return < var else 0)

    
    metrics_aggregated = {
        model_name: {
            "rmse": np.sqrt(mean_squared_error(realized_kernel, forecasts[model_name])),
            "mae": mean_absolute_error(realized_kernel, forecasts[model_name]),
        }
        for model_name in forecasts.keys()
    }
    # Backtesting and comparison
    backtest_results = {
        model_name: backtest_var(hit_var_results[model_name], 1 - confidence_level)
        for model_name in forecasts.keys()
    }

    # Perform DM test
    dm_test_results = calculate_dm_test_multiple(realized_kernel, forecasts)

    return {
        "metrics": metrics_aggregated,
        "backtest_results": backtest_results,
        "dm_test_results": dm_test_results,
        "forecasts": forecasts,
        "realized_kernel": realized_kernel,
        "test_log_returns": test_log_returns,
        "var_results": var_results,
        "hit_var_results": hit_var_results,
    }


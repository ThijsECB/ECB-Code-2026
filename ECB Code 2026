    # Class variables for model name and distribution type
    model_name = "Realized GAS-ast"
    distribution = "AST"

    def __init__(self, data, realized_kernel=None):
        # Initialize instance variables
        self.data = data
        self.realized_kernel = realized_kernel
        self.optimal_params = None
        self.log_likelihood_value = None
        self.aic = None
        self.bic = None
        self.convergence = None
        self.standard_errors = None

    def K(self, v):
        # Compute the K function for given degrees of freedom v
        return gamma((v + 1) / 2) / (np.sqrt(np.pi * v) * gamma(v / 2))

    def B(self, delta, v1, v2):
        # Compute the B function for given parameters delta, v1, and v2
        return delta * self.K(v1) + (1 - delta) * self.K(v2)

    def alpha_star(self, delta, v1, v2):
        # Compute the alpha_star parameter
        B = self.B(delta, v1, v2)
        return (delta * self.K(v1)) / B

    def m(self, delta, v1, v2):
        # Compute the m parameter
        alpha_star = self.alpha_star(delta, v1, v2)
        B = self.B(delta, v1, v2)
        return 4 * B * (-alpha_star**2 * v1 / (v1 - 1) + (1 - alpha_star)**2 * v2 / (v2 - 1))

    def s(self, delta, v1, v2):
        # Compute the s parameter
        alpha_star = self.alpha_star(delta, v1, v2)
        B = self.B(delta, v1, v2)
        m = self.m(delta, v1, v2)
        return np.sqrt(4 * (delta * alpha_star**2 * v1 / (v1 - 2) + (1 - delta) * (1 - alpha_star)**2 * v2 / (v2 - 2)) - m**2)
    
    def I_t(self, r_t, mu_t, h_t, m, s):
        # Indicator function I_t
        return 1 if m + s * (r_t - mu_t) / np.sqrt(h_t) > 0 else 0

    def A_t(self, r_t, mu_t, h_t, delta, v1, v2):
        # Compute the score function A_t
        m = self.m(delta, v1, v2)
        s = self.s(delta, v1, v2)
        alpha_star = self.alpha_star(delta, v1, v2)
        B = self.B(delta, v1, v2)
        I_t = 1 if m + s * (r_t - mu_t) / np.sqrt(h_t) > 0 else 0
        term1 = (s * (r_t - mu_t) / np.sqrt(h_t) + m) / (4 * (1 - alpha_star)**2 * v2 * ((s * (r_t - mu_t) / np.sqrt(h_t) + m)**2 / (4 * (1 - alpha_star)**2 * v2) + 1) * np.sqrt(h_t))
        term2 = (s * (r_t - mu_t) / np.sqrt(h_t) + m) / (4 * alpha_star**2 * v1 * ((s * (r_t - mu_t) / np.sqrt(h_t) + m)**2 / (4 * alpha_star**2 * v1) + 1) * np.sqrt(h_t))
        return -0.5 + I_t * (v2 + 1) / 2 * term1 + (1 - I_t) * (v2 + 1) / 2 * term2

    def log_likelihood(self, params):
        # Calculate the log-likelihood of the Realized GAS-ast model
        omega, alpha, beta, delta, nu, v1, v2 = params
        T = len(self.data)
        f = np.zeros(T)
        f[0] = np.log(np.var(self.data[:50]))  # Initialize at log of unconditional variance
        mu_t = 0  # Default mean of returns

        for t in range(T - 1):
            r_t = self.data[t]
            X_t = self.realized_kernel[t] 
            f_t = f[t]
            h_t = np.exp(f_t)
            term1 = (nu / 2) * ((X_t / h_t) - 1)
            term2 = self.A_t(r_t, mu_t, h_t, delta, v1, v2)
            nabla_t = term1 + term2
            S_t = 1
            f[t + 1] = omega + beta * f_t + alpha * (S_t * nabla_t)

        log_likelihood = 0
        for t in range(T):
            r_t = self.data[t]
            X_t = self.realized_kernel[t] 
            f_t = f[t]
            h_t = np.exp(f_t)
            m = self.m(delta, v1, v2)
            s = self.s(delta, v1, v2)
            alpha_star = self.alpha_star(delta, v1, v2)
            I_t = 1 if m + s * (r_t - mu_t) / np.sqrt(h_t) > 0 else 0
            B = self.B(delta, v1, v2)

            log_gamma = (-np.log(gamma(nu / 2)) - (nu / 2) * np.log(2 * np.exp(f_t) / nu) +
                         (nu / 2 - 1) * np.log(X_t) - (nu * X_t) / (2 * np.exp(f_t)))
            log_ast = (np.log(s) + np.log(B) - 0.5 * np.log(h_t) - 
                       (1 - I_t) * ((v1 + 1) / 2) * np.log(1 + (1 / v1) * ((m + s * (r_t - mu_t) / np.sqrt(h_t)) / (2 * alpha_star))**2) -
                       I_t * ((v2 + 1) / 2) * np.log(1 + (1 / v2) * ((m + s * (r_t - mu_t) / np.sqrt(h_t)) / (2 * (1 - alpha_star)))**2))

            log_likelihood += log_gamma + log_ast

        return -log_likelihood / T

    def compute_aic_bic(self, optimal_params):
        # Compute AIC and BIC metrics
        omega, alpha, beta, delta, nu, v1, v2 = optimal_params
        T = len(self.data)
        f = np.zeros(T)
        f[0] = np.log(np.var(self.data))  # Initialize at log of unconditional variance
        mu_t = 0  # Default mean of returns
        log_likelihood = 0

        # Compute the conditional variances
        for t in range(T - 1):
            r_t = self.data[t]
            X_t = self.realized_kernel[t]
            f_t = f[t]
            h_t = np.exp(f_t)

            term1 = (nu / 2) * ((X_t / h_t) - 1)
            term2 = self.A_t(r_t, mu_t, h_t, delta, v1, v2)
            nabla_t = term1 + term2
            S_t = 1
            f[t + 1] = omega + beta * f_t + alpha * (S_t * nabla_t)

        # Compute the log-likelihood
        for t in range(T):
            f_t = f[t]
            h_t = np.exp(f[t])
            m = self.m(delta, v1, v2)
            s = self.s(delta, v1, v2)
            alpha_star = self.alpha_star(delta, v1, v2)
            I_t = self.I_t(self.data[t], mu_t, h_t, self.m(delta, v1, v2), self.s(delta, v1, v2))
            B = self.B(delta, v1, v2)
            term5 = (v1 + 1) / 2 * np.log(1 + (1 / v1) * ((m + s * (self.data[t] - mu_t) / np.sqrt(h_t)) / (2 * alpha_star))**2)
            term6 = (v2 + 1) / 2 * np.log(1 + (1 / v2) * ((m + s * (self.data[t] - mu_t) / np.sqrt(h_t)) / (2 * (1 - alpha_star)))**2)
            log_ast = np.log(s) + np.log(B) - 0.5 * np.log(h_t) - (1 - I_t) * term5 - I_t * term6
            log_likelihood += log_ast 

        # Calculate AIC and BIC
        aic = 2 * len(optimal_params) - 2 * log_likelihood
        bic = np.log(T) * len(optimal_params) - 2 * log_likelihood
        print("The log-likelihood:", log_likelihood / T)
        return aic, bic


def CloseToCloseReturns(data):

    # Extract the last price for each day
    close_prices = []

    for date, group in data.groupby(data.index.date):
        # Get the last price of the group
        close_price = group.iloc[-1]['log price']
        close_prices.append({'date': date, 'close_price': close_price})

    # Create a DataFrame for the closing prices
    close_df = pd.DataFrame(close_prices)
    close_df['date'] = pd.to_datetime(close_df['date'])
    close_df.set_index('date', inplace=True)


    # Calculate log returns
    close_df['log_return'] = 100 * (close_df['close_price'] - close_df['close_price'].shift(1))

    # Drop the first row since it will have NaN
    close_df.dropna(inplace=True)

    return close_df['log_return'], close_df['close_price']

    

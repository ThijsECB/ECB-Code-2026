def irregular_prices_log_returns(price_data):
    """
    Process irregular second frequency prices for each day to calculate observations, returns, 
    and the number of returns per day.
    """
    # Ensure data is sorted by timestamp
    price_data = price_data.sort_index()
    
    # Group data by date
    price_data['Date'] = price_data.index.date
    daily_returns = []
    daily_counts = []

    for date, group in price_data.groupby('Date'):
        # Extract timestamps and prices for the day
        timestamps = group.index
        prices = group["log price"].values  # Log prices
        
        # Calculate observations
        n = len(prices)
        X = np.zeros(n)
        X[0] = 0.5 * (prices[0] + prices[1])  # X0
        X[1:-1] = prices[1:-1]  # Interior points
        X[-1] = 0.5 * (prices[-2] + prices[-1])  # Xn

        # Calculate high-frequency returns
        returns = np.diff(X)  # x_j = X_j - X_{j-1}
    
        # Append results for the day
        daily_returns.append(pd.DataFrame({
            "Timestamp": timestamps[1:],
            "Returns": returns,
            "Date": date
        }))
        daily_counts.append({
            "Date": date,
            "NumReturns": len(returns)
        })

    # Combine all daily results
    returns_df = pd.concat(daily_returns).set_index("Timestamp")
    counts_df = pd.DataFrame(daily_counts)
    counts_df['Date'] = pd.to_datetime(counts_df['Date'])
    counts_df.set_index("Date", inplace = True)
    

    return returns_df, counts_df


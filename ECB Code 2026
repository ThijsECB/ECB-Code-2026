def compute_omega_squared(log_prices, q=25):
    """
    Estimate omega^2 for each day and count the number of trades using irregularly spaced data.
    
    Parameters:
        log_prices (pd.Series): Log-price series indexed by irregular timestamps.
        q (int): Number of shifts for starting points (default: 25).
    
    Returns:
        omega_squared_df (pd.DataFrame): Estimated omega^2 for each day.
    """
    # Ensure the index is datetime
    log_prices.index = pd.to_datetime(log_prices.index)

    # Group data by trading day
    grouped = log_prices.groupby(log_prices.index.date)

    omega_squared_daily = {}

    for day, daily_prices in grouped:
        n = len(daily_prices)  # Count the number of trades for the day

        # Compute returns for the first shift only 
        returns = []

        for i in range(0, n - q, q):
            start = i
            end = i + q
            log_return = daily_prices.iloc[end] - daily_prices.iloc[start]
            returns.append(log_return)

        # Compute realized variance for the first shift
        rv_dense = np.sum(np.square(returns))
        num_nonzero = len(returns)
        # Estimate omega^2 for the first shift
        omega_squared = rv_dense / (2 * num_nonzero)
        omega_squared_daily[day] = omega_squared

    # Create DataFrame for omega_squared
    omega_squared_df = pd.DataFrame(list(omega_squared_daily.items()), columns=['Date', 'Omega_squared'])
    omega_squared_df['Date'] = pd.to_datetime(omega_squared_df['Date'])
    omega_squared_df.set_index("Date", inplace=True)

    return omega_squared_df


def realized_kernel(returns, bandwidth):
    """
    Calculate the realized kernel for a given set of returns and bandwidth.
    
    Parameters:
        returns (np.array): Array of returns for the day.
        bandwidth (int): Bandwidth H* for the kernel estimation.
    
    Returns:
        float: The realized kernel estimate.
    """
    n = len(returns)
    
    # Function to compute gamma_h
    def gamma_h(h):
        if h > 0:
            return np.sum(returns[h:] * returns[:n-h])
        else:
            return np.sum(returns**2)
    
    H = bandwidth
    kernel_values = [parzen_kernel(h / (H + 1)) for h in range(-H, H + 1)]
    realized_covariances = [gamma_h(abs(h)) for h in range(-H, H + 1)]
    
    kernel_estimate = np.sum(np.array(kernel_values) * np.array(realized_covariances))
    
    return kernel_estimate
def calculate_daily_realized_kernels(daily_returns_df, bandwidth_df):
    """
    Calculate realized kernels for each day using daily return data and bandwidths.
    
    Parameters:
        daily_returns_df (pd.DataFrame): DataFrame containing returns and dates.
        bandwidth_df (pd.DataFrame): DataFrame containing bandwidths (H_star) per day.
    
    Returns:
        pd.DataFrame: DataFrame with dates and realized kernel estimates.
    """
    realized_kernels = []
    
    # Group returns by day
    grouped_returns = daily_returns_df.groupby(daily_returns_df['Date'])
    
    for date, group in grouped_returns:
        # Convert `date` to pd.Timestamp to match the index type in `bandwidth_df`
        date = pd.Timestamp(date)
        
        returns = group['Returns'].values
        bandwidth = bandwidth_df.loc[date, 'H_star']
        
        # Calculate the realized kernel
        kernel_estimate = realized_kernel(returns, bandwidth)
        
        realized_kernels.append({'Date': date, 'RealizedKernel': kernel_estimate})
    
    # Convert to DataFrame
    realized_kernels_df = pd.DataFrame(realized_kernels)
    realized_kernels_df['Date'] = pd.to_datetime(realized_kernels_df['Date'])
    realized_kernels_df.set_index('Date', inplace=True)
    
    return realized_kernels_df

